generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model barbero {
  id       BigInt  @id @default(autoincrement())
  nombre   String  @unique @db.VarChar(255)
  activo   Boolean @default(true)
  comision Decimal @default(45.0)
  corte    corte[]
  turno    turno[]
}

model corte {
  id              BigInt    @id @default(autoincrement())
  cliente         String    @db.VarChar(255)
  monto           Decimal
  montoBarberia   Decimal
  comisionBarbero Decimal
  barberoId       BigInt
  metodoPago      String
  hora            DateTime? @default(now())
  barbero         barbero   @relation(fields: [barberoId], references: [id], map: "Corte_barberoId_fkey")

  @@index([barberoId], map: "Corte_barberoId_fkey")
}

model turno {
  id        BigInt   @id @default(autoincrement())
  cliente   String
  barberoId BigInt
  hora      DateTime

  barbero barbero @relation(fields: [barberoId], references: [id], map: "Turno_barberoId_fkey", onDelete: Cascade)

  @@index([barberoId], map: "Turno_barberoId_fkey")
}

enum EstadoCorte {
  PENDIENTE
  COMPLETADO
  CANCELADO
}

model usuario {
  id            BigInt @id @default(autoincrement())
  email         String @unique
  contrasena    String
  nombre        String
  nombreUsuario String @unique(map: "Usuario_nombreUsuario_key")
}
