generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model barbero {
  id       BigInt  @id @default(autoincrement())
  nombre   String  @unique @db.VarChar(255)
  activo   Boolean @default(true)
  comision Decimal @default(45.0)
  corte    corte[]
  turno    turno[]
}

enum RolUsuario {
  NORMAL
  SOLO_REGISTRO
}

model corte {
  id              BigInt    @id @default(autoincrement())
  cliente         String    @db.VarChar(255)
  monto           Decimal
  montoBarberia   Decimal
  comisionBarbero Decimal
  propina         Decimal   @default(0.0)
  barberoId       BigInt
  metodoPago      String
  hora            DateTime? @default(now())
  barbero         barbero   @relation(fields: [barberoId], references: [id], onDelete: Cascade, map: "Corte_barberoId_fkey")

  @@index([barberoId], map: "Corte_barberoId_fkey")
}

model turno {
  id        BigInt   @id @default(autoincrement())
  cliente   String
  barberoId BigInt
  hora      DateTime

  barbero barbero @relation(fields: [barberoId], references: [id], map: "Turno_barberoId_fkey", onDelete: Cascade)

  @@index([barberoId], map: "Turno_barberoId_fkey")
}

model precioCorte {
  id          BigInt  @id @default(autoincrement())
  monto       Decimal
  descripcion String? @db.VarChar(255)
  activo      Boolean @default(true)
}

enum EstadoCorte {
  PENDIENTE
  COMPLETADO
  CANCELADO
}

model usuario {
  id            BigInt     @id @default(autoincrement())
  email         String     @unique
  contrasena    String
  nombre        String
  nombreUsuario String     @unique(map: "Usuario_nombreUsuario_key")
  rol           RolUsuario @default(NORMAL)
}

model Administrador {
  id         BigInt @id @default(autoincrement())
  email      String @unique
  nombre     String
  contrasena String
}

model registro {
  id       BigInt   @id @default(autoincrement())
  hora     DateTime @default(now())
  registro String   @db.Text
}
